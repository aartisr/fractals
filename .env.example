# ====================
# DATABASE CONFIGURATION
# ====================
DB_USER=ntv
DB_PASSWORD=password
DATABASE=nithyananda-tv
DATABASE_URI=postgresql://ntv:password@db:5432/nithyananda-tv


# ====================
# PAYLOAD CMS
# ====================
PAYLOAD_SECRET=change-me-in-production
SERVER_URL=https://cms.url

#Payload CMS Variables
# ===========================
CMS_URL=https://dev.url
CMS_API_KEY=secret_api_key_here

# ============================================
# Auth Service Configuration (auth.kailasa.ai)
# ============================================
# Production auth service endpoint
AUTH_BASE=https://auth.url
# Your OAuth Client Credentials (replace with your actual values)
# Get these from your auth service admin panel
AUTH_CLIENT_ID=client-id-placeholder
AUTH_CLIENT_SECRET=client-secret-placeholder

# ====================
# MEDIA URLS
# ====================
# Public media base URL (for videos and thumbnails)
MEDIA_BASE_URL=https://cdn.url


# Redirect URLs (must match registered URLs in auth service)
# Development
AUTH_REDIRECT_URI=http://localhost:5173/auth/return
AUTH_ERROR_URL=http://localhost:5173/auth/error

# Set to 'false' for local development, 'true' for production
PUBLIC_PRODUCTION=true

# Production (uncomment and update when deploying)
# AUTH_REDIRECT_URI=https://your-domain.com/auth/return
# AUTH_ERROR_URL=https://your-domain.com/auth/error

# ====================
# QWIK WEB FRONTEND
# ====================
# Public origin used by Qwik during SSR and actions
ORIGIN=http://localhost:3000

# Web is stateless and uses APIs only; disable DB by default
PRIVATE_TURSO_DATABASE_URL=disabled
# PRIVATE_TURSO_AUTH_TOKEN=

# ====================
# LIVE TRANSCODER
# ====================
# Live transcoder service host and port
# For Docker: use service name 'live-transcoder' (or container name 'ntv-live-transcoder')
# For local dev: use 'localhost'
LIVE_TRANSCODER_HOST=live-transcoder
LIVE_TRANSCODER_PORT=8080
# RTMP server port (configured in live_transcoder config.yaml)
RTMP_PORT=1935

# Transcoder Settings
TRANSCODER_LOG_LEVEL=info
TRANSCODER_SEGMENT_DURATION=4
TRANSCODER_TEMP_DIR=/app/temp

# ====================
# R2/S3 STORAGE (for Live Transcoder)
# ====================
# Cloudflare R2 or S3-compatible storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ntv-ott
R2_ACCESS_KEY=your-access-key-here
R2_SECRET_KEY=your-secret-key-here
R2_PUBLIC_URL=https://ntv-cdn.nithyananda.ai
R2_REGION=auto
