# ====================
# DATABASE CONFIGURATION
# ====================
DB_USER=ntv
DB_PASSWORD=password
DATABASE=nithyananda-tv
DATABASE_URI=postgresql://ntv:password@db:5432/nithyananda-tv


# ====================
# PAYLOAD CMS
# ====================
PAYLOAD_SECRET=change-me-in-production


# ============================================
# Auth Service Configuration (auth.kailasa.ai)
# ============================================
# Production auth service endpoint
AUTH_BASE=https://auth.kailasa.ai
# Your OAuth Client Credentials (replace with your actual values)
# Get these from your auth service admin panel
AUTH_CLIENT_ID=client-id-placeholder
AUTH_CLIENT_SECRET=client-secret-placeholder

# Redirect URLs (must match registered URLs in auth service)
# Development
AUTH_REDIRECT_URI=http://localhost:5173/auth/return
AUTH_ERROR_URL=http://localhost:5173/auth/error

# Set to 'false' for local development, 'true' for production
PUBLIC_PRODUCTION=true

# Production (uncomment and update when deploying)
# AUTH_REDIRECT_URI=https://your-domain.com/auth/return
# AUTH_ERROR_URL=https://your-domain.com/auth/error

# ====================
# QWIK WEB FRONTEND
# ====================
# Public origin used by Qwik during SSR and actions
ORIGIN=http://localhost:3000

# Web is stateless and uses APIs only; disable DB by default
PRIVATE_TURSO_DATABASE_URL=disabled
# PRIVATE_TURSO_AUTH_TOKEN=
